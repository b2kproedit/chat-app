{
  "name": "chat-app",
  "version": "1.0.0",
  "description": "Real-time chat app with rooms, online users and typing indicators, built with Next.js, PostgreSQL, Drizzle ORM and Server-Sent Events.",
  "license": "MIT",
  "author": "b2kproedit",
  "repository": {
    "type": "git",
    "url": "https://github.com/b2kproedit/chat-app.git"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push --config=drizzle.config.json",
    "db:studio": "drizzle-kit studio --config=drizzle.config.json"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "date-fns": "^4.4.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
